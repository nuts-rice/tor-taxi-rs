# Tor for the checker, and nothing else. Loopback-bound, never published.

# IsolateSOCKSAuth is already the default, but the checker depends on it
# totally: proxy.rs hands every probe a fresh SOCKS username so each link gets
# its own circuit. It is what proxy::verify_isolation() checks at startup.
SocksPort 9050 IsolateSOCKSAuth

# A named volume, so entry guards survive a restart -- the state entrypoint.sh's
# TERM trap exists to flush.
DataDirectory /var/lib/tor

# entrypoint.sh reads this stream to decide when Tor is ready, watching for
# "Bootstrapped 100%". Send Tor's log anywhere else and the checker never
# starts: entrypoint waits out BOOTSTRAP_TIMEOUT and the container exits 1.
Log notice stdout

# PID 1 has to stay in the foreground; daemonising exits the container.
RunAsDaemon 0

ClientOnly 1

# The Pi boots off an SD card and Tor writes state eagerly by default.
AvoidDiskWrites 1
